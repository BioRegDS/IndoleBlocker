cd ~/GitHub/IndoleBlocker

cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Local reproducibility checks
qc_reproduction/

# Model caches and temporary files
.cache/
*.tmp
*.log

# Data not intended for publication
data/raw/
data/large/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Local environment
.env
.venv/
venv/

# Local environment exports
environment_full.yml
environment_history.yml

# Empty placeholder
requirements.txt
EOF
# Editor backup files
*~

# QC comparison images
figures/figure1/Figure1_difference.png
